FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install build tooling
RUN pip install --no-cache-dir hatchling

# Copy package sources
COPY boardfarm3_control ./boardfarm3_control
COPY boardfarm3 ./boardfarm3
COPY control/pyproject.toml ./control/pyproject.toml
COPY pyproject.toml README.md LICENSE ./
COPY docs/index.md ./docs/index.md

# Install boardfarm3 (needed for hookspec discovery) then the control plane
RUN pip install --no-cache-dir ".[api]" && \
    pip install --no-cache-dir "control/"

EXPOSE 9000

CMD ["python", "-m", "boardfarm3_control"]
